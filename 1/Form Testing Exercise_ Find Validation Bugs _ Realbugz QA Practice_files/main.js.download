let currentLanguage = 'en';

// Set language function
window.setLanguage = function(lang) {
    if (!i18n[lang]) return;
    currentLanguage = lang;
    
    // Toggle active classes on buttons
    document.getElementById('btn-en').classList.toggle('active', lang === 'en');
    document.getElementById('btn-th').classList.toggle('active', lang === 'th');
    
    // Update elements
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        const text = i18n[lang][key];
        if (text) {
            if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                // Handle placeholders for input elements
                if (key.startsWith('placeholder-')) {
                    el.placeholder = text;
                }
            } else {
                el.textContent = text;
            }
        }
    });

    // Update dynamic placeholders manually
    document.getElementById('applicantId').placeholder = i18n[lang]['placeholder-id'];
    document.getElementById('firstName').placeholder = i18n[lang]['placeholder-first-name'];
    document.getElementById('lastName').placeholder = i18n[lang]['placeholder-last-name'];
    document.getElementById('email').placeholder = i18n[lang]['placeholder-email'];
    document.getElementById('contactNumber').placeholder = i18n[lang]['placeholder-phone'];
};

// Slider for Salary Range
document.addEventListener('DOMContentLoaded', function() {
    const rangeInput = document.getElementById('range');
    const rangeValue = document.getElementById('rangeValue');

    if (rangeInput && rangeValue) {
        // Update value on page load
        rangeValue.textContent = rangeInput.value;

        // Update value when slider moves
        rangeInput.addEventListener('input', function() {
            rangeValue.textContent = this.value;
        });
    }

    // Initialize with English
    setLanguage('en');
    
    // Bug 4: Date limit is missing (No dobInput.max restriction, allowing future dates)
});

// Form submission processing with validation checks
document.getElementById('expeditionForm').addEventListener('submit', function(e) {
    e.preventDefault();

    // Bug 8: Applicant ID validation mismatch
    // The label says format is ELD-xxxx (4 digits), but JS regex validates for ELD-xxx (3 digits)
    const applicantId = document.getElementById('applicantId').value;
    const idRegex = /^ELD-[0-9]{3}$/; // Validates only 3 digits!
    if (!idRegex.test(applicantId)) {
        if (currentLanguage === 'th') {
            alert('ข้อผิดพลาด: รหัสผู้สมัครไม่ถูกต้อง! รูปแบบต้องขึ้นต้นด้วย ELD- ตามด้วยตัวเลข 4 หลัก (เช่น ELD-1234)');
        } else {
            alert('Error: Invalid Applicant ID! Format must start with ELD- followed by 4 digits (e.g., ELD-1234)');
        }
        return;
    }

    // Bug 5: Mismatched File Upload Validation (Accepts PDF in HTML, but JS throws error)
    const fileInput = document.getElementById('passport');
    if (fileInput.files.length > 0) {
        const fileName = fileInput.files[0].name;
        const fileExt = fileName.split('.').pop().toLowerCase();
        if (fileExt === 'pdf') {
            if (currentLanguage === 'th') {
                alert('ข้อผิดพลาด: ระบบไม่รองรับไฟล์ PDF!');
            } else {
                alert('Error: PDF files are not supported by the system!');
            }
            return;
        }
    }

    // Bug 6: Logical age validator bug (Math typo: age limit is set to < 81 instead of < 18)
    const dobValue = document.getElementById('dob').value;
    if (dobValue) {
        const dob = new Date(dobValue);
        const today = new Date();
        let age = today.getFullYear() - dob.getFullYear();
        const monthDiff = today.getMonth() - dob.getMonth();
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
            age--;
        }
        if (age < 81) {
            if (currentLanguage === 'th') {
                alert('คุณต้องมีอายุอย่างน้อย 81 ปีเพื่อลงทะเบียนเข้าร่วมการเดินทางสำรวจ');
            } else {
                alert('You must be at least 81 years old to register for the expedition.');
            }
            return;
        }
    }

    // Bug 7: Allow submit with 0 roles checked (No roles check)

    if (currentLanguage === 'th') {
        alert('ส่งแบบฟอร์มลงทะเบียนสำเร็จ!');
    } else {
        alert('The form has been successfully validated and submitted!');
    }
});
