let currentLanguage = 'en';

// Dynamic Salary Limit Hint Update Function
window.updateSalaryHint = function() {
    const experienceSelect = document.getElementById('experience');
    const hintDiv = document.getElementById('salaryLimitHint');
    if (!experienceSelect || !hintDiv) return;

    const val = experienceSelect.value;
    let hintText = "";

    if (val === 'none') {
        hintText = currentLanguage === 'th' ? "* จำกัดเงินเดือนสูงสุดไม่เกิน $900" : "* Maximum allowed salary is $900";
    } else if (val === 'amateur') {
        hintText = currentLanguage === 'th' ? "* ประสบการณ์ไม่เกิน 1 ปี: จำกัดเงินเดือนสูงสุดไม่เกิน $1,125" : "* Amateur (up to 1 year): Maximum allowed salary is $1,125";
    } else if (val === 'intermediate') {
        hintText = currentLanguage === 'th' ? "* ประสบการณ์ 1-5 ปี: จำกัดเงินเดือนสูงสุดไม่เกิน $1,550" : "* Intermediate (1-5 years): Maximum allowed salary is $1,550";
    } else if (val === 'professional') {
        hintText = currentLanguage === 'th' ? "* ประสบการณ์มากกว่า 5 ปี: ยื่นเงินเดือนตามความประสงค์ได้อิสระ (ไม่เกิน $2,250)" : "* Professional: Any salary is allowed (up to $2,250)";
    }

    hintDiv.textContent = hintText;
};

// Set language function
window.setLanguage = function(lang) {
    if (!i18n[lang]) return;
    currentLanguage = lang;
    
    // Toggle active classes on buttons
    document.getElementById('btn-en').classList.toggle('active', lang === 'en');
    document.getElementById('btn-th').classList.toggle('active', lang === 'th');
    
    // Update elements
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        const text = i18n[lang][key];
        if (text) {
            if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                if (key.startsWith('placeholder-')) {
                    el.placeholder = text;
                }
            } else {
                el.textContent = text;
            }
        }
    });

    // Update dynamic placeholders manually
    document.getElementById('applicantId').placeholder = i18n[lang]['placeholder-id'];
    document.getElementById('firstName').placeholder = i18n[lang]['placeholder-first-name'];
    document.getElementById('lastName').placeholder = i18n[lang]['placeholder-last-name'];
    document.getElementById('email').placeholder = i18n[lang]['placeholder-email'];
    document.getElementById('contactNumber').placeholder = i18n[lang]['placeholder-phone'];

    // Update salary limit hint text in selected language
    updateSalaryHint();

    // Update readiness checklist language
    if (window.updateReadinessChecklist) updateReadinessChecklist();
};

// Custom HTML Slider Dragging & Clicking Logic
function initCustomSlider() {
    const track = document.getElementById('custom-slider-track');
    const thumb = document.getElementById('custom-slider-thumb');
    const fill = document.getElementById('custom-slider-fill');
    const rangeInput = document.getElementById('range');
    const rangeValue = document.getElementById('rangeValue');

    if (!track || !thumb || !fill) return;

    let isDragging = false;
    let prevVal = 700;
    const marks = [
        { id: 'mark-900', value: 900 },
        { id: 'mark-1125', value: 1125 },
        { id: 'mark-1550', value: 1550 }
    ];

    // Helper to update slider values and UI
    window.setCustomSliderValue = function(val) {
        val = Math.max(700, Math.min(2250, val));
        rangeInput.value = val;
        rangeValue.textContent = val;

        const pct = (val - 700) / 1550;
        thumb.style.left = (pct * 100) + '%';
        fill.style.width = (pct * 100) + '%';

        // Trigger star pop on target values
        if (val === 900) triggerStarPop('mark-900');
        if (val === 1125) triggerStarPop('mark-1125');
        if (val === 1550) triggerStarPop('mark-1550');

        prevVal = val;
    };

    function updateValueFromCoords(clientX) {
        const rect = track.getBoundingClientRect();
        let pct = (clientX - rect.left) / rect.width;
        pct = Math.max(0, Math.min(1, pct));
        
        const currentVal = Math.round(700 + pct * 1550);
        rangeInput.value = currentVal;
        rangeValue.textContent = currentVal;
        thumb.style.left = (pct * 100) + '%';
        fill.style.width = (pct * 100) + '%';

        // Check if value crossed thresholds
        marks.forEach(mark => {
            const crossed = (prevVal < mark.value && currentVal >= mark.value) || 
                            (prevVal > mark.value && currentVal <= mark.value) ||
                            (currentVal === mark.value);
            if (crossed && prevVal !== currentVal) {
                triggerStarPop(mark.id);
            }
        });

        prevVal = currentVal;
    }

    track.addEventListener('mousedown', function(e) {
        isDragging = true;
        updateValueFromCoords(e.clientX);
        e.preventDefault();
    });

    document.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        updateValueFromCoords(e.clientX);
    });

    document.addEventListener('mouseup', function() {
        isDragging = false;
    });

    // Touch events for mobile screens
    track.addEventListener('touchstart', function(e) {
        isDragging = true;
        updateValueFromCoords(e.touches[0].clientX);
        e.preventDefault();
    });

    document.addEventListener('touchmove', function(e) {
        if (!isDragging) return;
        updateValueFromCoords(e.touches[0].clientX);
    });

    document.addEventListener('touchend', function() {
        isDragging = false;
    });

    // Initialize default value
    setCustomSliderValue(700);
}

// Helper: Triggers star bounce animation
window.triggerStarPop = function(id) {
    const markEl = document.getElementById(id);
    if (!markEl) return;
    const star = markEl.querySelector('.star-pop');
    if (star) {
        star.classList.remove('animate');
        void star.offsetWidth; // Force layout reflow to restart CSS keyframe animation
        star.classList.add('animate');
    }
};

// Slider and page features initialization
document.addEventListener('DOMContentLoaded', function() {
    // Initialize Custom HTML Slider (binds click/drag events and colors progress purple)
    initCustomSlider();

    // Initialize with English language
    setLanguage('en');

    // Initialize Readiness Checklist & live validation tracker
    initReadinessListeners();

    // Dynamic DOB restriction: Limit selectable date to at least 18 years ago today
    const dobInput = document.getElementById('dob');
    if (dobInput) {
        const eighteenYearsAgo = new Date();
        eighteenYearsAgo.setFullYear(eighteenYearsAgo.getFullYear() - 18);
        const maxDate = eighteenYearsAgo.toISOString().split('T')[0];
        dobInput.max = maxDate;
    }
});

// Form submission processing with validation checks
document.getElementById('expeditionForm').addEventListener('submit', function(e) {
    e.preventDefault();

    // Validating Applicant ID: Requires exactly 10 digits
    const applicantId = document.getElementById('applicantId').value;
    const idRegex = /^[0-9]{10}$/; // Exactly 10 digits
    if (!idRegex.test(applicantId)) {
        if (currentLanguage === 'th') {
            alert('โปรดใส่ตัวเลขรหัสนักศึกษา 10 ตัว');
        } else {
            alert('Please enter your 10-digit Student ID.');
        }
        return;
    }

    // Validating First Name & Last Name: Letters only (English or Thai), min 5 characters
    const nameRegex = /^[a-zA-Z\u0E00-\u0E7F]{5,}$/;
    
    const firstName = document.getElementById('firstName').value;
    if (!nameRegex.test(firstName)) {
        if (currentLanguage === 'th') {
            alert('ชื่อต้องประกอบด้วยตัวอักษรภาษาอังกฤษหรือภาษาไทยเท่านั้น (ห้ามใส่ตัวเลข หรืออักขระพิเศษ) และต้องมีความยาวอย่างน้อย 5 ตัวอักษรขึ้นไป');
        } else {
            alert('First Name must contain only English or Thai letters (no numbers or special characters) and be at least 5 characters long.');
        }
        return;
    }

    const lastName = document.getElementById('lastName').value;
    if (!nameRegex.test(lastName)) {
        if (currentLanguage === 'th') {
            alert('นามสกุลต้องประกอบด้วยตัวอักษรภาษาอังกฤษหรือภาษาไทยเท่านั้น (ห้ามใส่ตัวเลข หรืออักขระพิเศษ) และต้องมีความยาวอย่างน้อย 5 ตัวอักษรขึ้นไป');
        } else {
            alert('Last Name must contain only English or Thai letters (no numbers or special characters) and be at least 5 characters long.');
        }
        return;
    }

    // Validating Email: Correct format check
    const email = document.getElementById('email').value;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
        if (currentLanguage === 'th') {
            alert('โปรดกรอกที่อยู่อีเมลให้ถูกต้องตามรูปแบบ (เช่น test@email.com)');
        } else {
            alert('Please enter a valid email address (e.g., test@email.com).');
        }
        return;
    }

    // Validating Contact Number: 7-10 digits (excluding country code prefix)
    const contactNumber = document.getElementById('contactNumber').value;
    const phoneRegex = /^[0-9]{7,10}$/; // Phone digits only, 7 to 10 digits
    if (!phoneRegex.test(contactNumber)) {
        if (currentLanguage === 'th') {
            alert('โปรดกรอกเบอร์โทรศัพท์ติดต่อด้วยตัวเลข 7 ถึง 10 หลัก (ระบุรหัสประเทศในช่องด้านข้าง)');
        } else {
            alert('Please enter your contact number using 7 to 10 digits (excluding the country dial code).');
        }
        return;
    }

    // Validating Salary limit rules based on selected experience
    const experience = document.getElementById('experience').value;
    const salary = parseInt(document.getElementById('range').value);

    if (experience === 'none' && salary > 900) {
        if (currentLanguage === 'th') {
            alert('ไม่อนุญาตยื่นขอเงินเดือนมากกว่า $900 สำหรับผู้ที่ไม่มีประสบการณ์');
        } else {
            alert('For "No experience", the maximum allowed salary is $900.');
        }
        return;
    } else if (experience === 'amateur' && salary > 1125) {
        if (currentLanguage === 'th') {
            alert('ไม่อนุญาตยื่นขอเงินเดือนมากกว่า $1,125 สำหรับผู้ที่มีประสบการณ์ไม่เกิน 1 ปี');
        } else {
            alert('For "Amateur (up to 1 year)", the maximum allowed salary is $1,125.');
        }
        return;
    } else if (experience === 'intermediate' && salary > 1550) {
        if (currentLanguage === 'th') {
            alert('ไม่อนุญาตยื่นขอเงินเดือนมากกว่า $1,550 สำหรับผู้ที่มีประสบการณ์ 1-5 ปี');
        } else {
            alert('For "Intermediate (1-5 years)", the maximum allowed salary is $1,550.');
        }
        return;
    }



    // Requires at least one role checkbox to be checked
    const roles = document.querySelectorAll('input[name="role"]:checked');
    if (roles.length === 0) {
        if (currentLanguage === 'th') {
            alert('โปรดเลือกบทบาทหน้าที่ในคณะสำรวจอย่างน้อย 1 อย่าง');
        } else {
            alert('Please select at least one Preferred Role in the Expedition.');
        }
        return;
    }

    // Age validator logic limit to 18 years old (validated via date checks)
    const dobValue = document.getElementById('dob').value;
    if (dobValue) {
        const dob = new Date(dobValue);
        const today = new Date();
        let age = today.getFullYear() - dob.getFullYear();
        const monthDiff = today.getMonth() - dob.getMonth();
        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
            age--;
        }
        if (age < 18) {
            if (currentLanguage === 'th') {
                alert('คุณต้องมีอายุอย่างน้อย 18 ปีเพื่อลงทะเบียนเข้าร่วมการเดินทางสำรวจ');
            } else {
                alert('You must be at least 18 years old to register for the expedition.');
            }
            return;
        }
    }

    if (currentLanguage === 'th') {
        alert('ส่งแบบฟอร์มลงทะเบียนสำเร็จ!');
    } else {
        alert('The form has been successfully validated and submitted!');
    }
});

// Form Auto-fill Logic for QA testing
window.autoFillForm = function() {
    document.getElementById('applicantId').value = '0000000000';
    document.getElementById('firstName').value = 'AAAAAAAAAAAA';
    document.getElementById('lastName').value = 'AAAAAA';
    document.getElementById('email').value = 'oavatan@gmail.com';
    document.getElementById('contactNumber').value = '0000000000';
    document.getElementById('dob').value = '2005-08-21';
    
    // Select Archaeology Experience
    document.getElementById('experience').value = 'professional';
    if (window.updateSalaryHint) {
        window.updateSalaryHint();
    }
    
    // Select preferred role: Medic
    document.querySelectorAll('input[name="role"]').forEach(cb => cb.checked = false);
    const medicCheckbox = document.getElementById('medic');
    if (medicCheckbox) {
        medicCheckbox.checked = true;
    }
    
    // Select Preferred Expedition Region: Universe
    const universeRadio = document.getElementById('universe');
    if (universeRadio) {
        universeRadio.checked = true;
    }
    
    // Set custom slider value to 2000
    if (window.setCustomSliderValue) {
        window.setCustomSliderValue(2000);
    }
    
    // Agree to terms for 100% readiness
    const termsCheckbox = document.getElementById('terms');
    if (termsCheckbox) {
        termsCheckbox.checked = true;
    }

    // Void the required check for Passport/ID upload
    const passportInput = document.getElementById('passport');
    if (passportInput) {
        passportInput.removeAttribute('required');
    }
    
    if (window.updateReadinessChecklist) {
        window.updateReadinessChecklist();
    }
    
    console.log("Form auto-filled and Passport upload requirement set to void!");
};

// ----------------------------------------------------
// Hint System Logic inside ELDORIA Header
// ----------------------------------------------------
window.toggleHintCollapse = function() {
    const widget = document.getElementById('hintsWidget');
    if (widget) {
        widget.classList.toggle('collapsed');
    }
};
window.toggleHintDrawer = window.toggleHintCollapse;

// ----------------------------------------------------
// Readiness Checklist & Percentage Tracker
// ----------------------------------------------------
window.toggleReadinessCollapse = function() {
    const widget = document.getElementById('readinessWidget');
    if (widget) {
        widget.classList.toggle('collapsed');
    }
};

const checklistDefinitions = [
    { id: 'chk-id', fieldId: 'applicantId', labelKey: 'chk-id', validate: () => {
        const val = (document.getElementById('applicantId')?.value || '').trim();
        return /^[0-9]{10}$/.test(val);
    }},
    { id: 'chk-fname', fieldId: 'firstName', labelKey: 'chk-fname', validate: () => {
        const val = (document.getElementById('firstName')?.value || '').trim();
        return /^[a-zA-Z\u0E00-\u0E7F]{5,}$/.test(val);
    }},
    { id: 'chk-lname', fieldId: 'lastName', labelKey: 'chk-lname', validate: () => {
        const val = (document.getElementById('lastName')?.value || '').trim();
        return /^[a-zA-Z\u0E00-\u0E7F]{5,}$/.test(val);
    }},
    { id: 'chk-email', fieldId: 'email', labelKey: 'chk-email', validate: () => {
        const val = (document.getElementById('email')?.value || '').trim();
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
    }},
    { id: 'chk-phone', fieldId: 'contactNumber', labelKey: 'chk-phone', validate: () => {
        const val = (document.getElementById('contactNumber')?.value || '').trim();
        return /^[0-9]{7,10}$/.test(val);
    }},
    { id: 'chk-dob', fieldId: 'dob', labelKey: 'chk-dob', validate: () => {
        const val = document.getElementById('dob')?.value;
        if (!val) return false;
        const dob = new Date(val);
        const today = new Date();
        let age = today.getFullYear() - dob.getFullYear();
        const m = today.getMonth() - dob.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
        return age >= 18;
    }},
    { id: 'chk-role', fieldId: 'role', labelKey: 'chk-role', validate: () => {
        return document.querySelectorAll('input[name="role"]:checked').length > 0;
    }},
    { id: 'chk-region', fieldId: 'region', labelKey: 'chk-region', validate: () => {
        return document.querySelectorAll('input[name="region"]:checked').length > 0;
    }},
    { id: 'chk-salary', fieldId: 'range', labelKey: 'chk-salary', validate: () => {
        const exp = document.getElementById('experience')?.value || 'none';
        const salary = parseInt(document.getElementById('range')?.value || '700');
        if (exp === 'none' && salary > 900) return false;
        if (exp === 'amateur' && salary > 1125) return false;
        if (exp === 'intermediate' && salary > 1550) return false;
        return true;
    }},
    { id: 'chk-passport', fieldId: 'passport', labelKey: 'chk-passport', validate: () => {
        const input = document.getElementById('passport');
        if (!input) return false;
        if (!input.hasAttribute('required')) return true; // Bypassed by auto-fill
        return input.files && input.files.length > 0;
    }},
    { id: 'chk-terms', fieldId: 'terms', labelKey: 'chk-terms', validate: () => {
        return document.getElementById('terms')?.checked === true;
    }}
];

window.updateReadinessChecklist = function() {
    const listContainer = document.getElementById('readinessItemsList');
    const percentEl = document.getElementById('readinessPercent');
    const fillEl = document.getElementById('readinessProgressFill');
    if (!listContainer || !percentEl || !fillEl) return;

    let completedCount = 0;
    const totalCount = checklistDefinitions.length;

    listContainer.innerHTML = '';

    checklistDefinitions.forEach(item => {
        const isDone = item.validate();
        if (isDone) completedCount++;

        const labelText = (i18n[currentLanguage] && i18n[currentLanguage][item.labelKey]) || item.labelKey;

        const row = document.createElement('div');
        row.className = `readiness-item ${isDone ? 'done' : ''}`;
        row.innerHTML = `
            <span class="item-status-icon">${isDone ? '✓' : '○'}</span>
            <span class="item-label">${labelText}</span>
        `;

        // Click to focus and scroll to field
        row.addEventListener('click', () => {
            const targetEl = document.getElementById(item.fieldId);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                targetEl.focus();
            }
        });

        listContainer.appendChild(row);
    });

    const percent = Math.round((completedCount / totalCount) * 100);
    percentEl.textContent = `${percent}%`;
    fillEl.style.width = `${percent}%`;

    if (percent === 100) {
        percentEl.classList.add('complete');
        fillEl.classList.add('complete');
    } else {
        percentEl.classList.remove('complete');
        fillEl.classList.remove('complete');
    }
};

// Hook into form inputs for live real-time checklist validation
function initReadinessListeners() {
    const form = document.getElementById('expeditionForm');
    if (form) {
        form.addEventListener('input', window.updateReadinessChecklist);
        form.addEventListener('change', window.updateReadinessChecklist);
        form.addEventListener('reset', () => setTimeout(window.updateReadinessChecklist, 50));
    }
    window.updateReadinessChecklist();
}
